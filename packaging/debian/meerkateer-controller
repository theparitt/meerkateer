#!/usr/bin/env bash
set -euo pipefail

readonly controller_binary="/usr/lib/meerkateer/meerkateer-controller"
readonly config_path="/var/lib/meerkateer-controller/agent.json"
readonly service_name="meerkateer-controller.service"
readonly service_user="meerkateer-controller"

require_root() {
  if [[ ${EUID} -ne 0 ]]; then
    echo "run 'sudo meerkateer-controller $*'" >&2
    exit 1
  fi
}

setup_controller() {
  require_root "${1:-tui}"
  runuser -u "$service_user" -- "$controller_binary" --config "$config_path" tui

  if [[ ! -f "$config_path" ]]; then
    echo "Setup closed without enrolling this computer; the background service was not started."
    return 0
  fi

  systemctl enable "$service_name" >/dev/null
  systemctl restart "$service_name"
  runuser -u "$service_user" -- "$controller_binary" --config "$config_path" doctor
  echo
  echo "Meerkateer Controller is installed and running."
  echo "Use 'sudo meerkateer-controller tui' to monitor this host or change signals."
}

case "${1:-}" in
  setup|tui)
    action="$1"
    shift
    setup_controller "$action" "$@"
    ;;
  status)
    require_root status
    runuser -u "$service_user" -- "$controller_binary" --config "$config_path" doctor
    systemctl --no-pager --full status "$service_name"
    ;;
  test-connection)
    require_root test-connection
    shift
    runuser -u "$service_user" -- "$controller_binary" --config "$config_path" \
      test-connection "$@"
    ;;
  start|stop|restart)
    action="$1"
    shift
    require_root "$action"
    systemctl "$action" "$service_name"
    ;;
  '')
    cat <<'EOF'
Meerkateer Controller

  sudo meerkateer-controller setup    First setup in the Rust terminal UI
  sudo meerkateer-controller tui      Monitor this host or change signals
  sudo meerkateer-controller status   Check enrollment and background service
  sudo meerkateer-controller test-connection --server https://api.example.com
                                      Test storage, network, TLS, and API readiness
  sudo meerkateer-controller restart  Restart telemetry delivery

Advanced CLI:
  meerkateer-controller --help
EOF
    ;;
  *)
    exec "$controller_binary" "$@"
    ;;
esac

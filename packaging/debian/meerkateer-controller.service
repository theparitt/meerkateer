[Unit]
Description=Meerkateer outbound monitoring controller
Documentation=https://github.com/theparitt/meerkateer
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/meerkateer-controller/agent.json

[Service]
Type=simple
User=meerkateer-controller
Group=meerkateer-controller
UMask=0077
ExecStart=/usr/lib/meerkateer/meerkateer-controller --config /var/lib/meerkateer-controller/agent.json run
Restart=always
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meerkateer.dev/schemas/mks-1/server-info.schema.json",
  "title": "MKS-1 Server Info",
  "description": "Response body for GET /server-info. Human/info build + mode block. MUST NOT contain secrets or PII.",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "version", "mode", "build"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mode": { "type": "string", "minLength": 1, "maxLength": 128 },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["built_at_utc", "git_sha", "git_branch"],
      "properties": {
        "built_at_utc": {
          "anyOf": [
            { "const": "unknown" },
            { "type": "string", "format": "date-time", "maxLength": 35, "pattern": "Z$" }
          ]
        },
        "git_sha": { "type": "string", "minLength": 1, "maxLength": 128 },
        "git_branch": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}

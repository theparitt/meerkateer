{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meerkateer.dev/schemas/mks-1/event.schema.json",
  "title": "MKS-1 Event Push Payload",
  "description": "Body for POST <MEERKATEER_INGEST_URL>/v1/ingest/event.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interface_version",
    "service",
    "project",
    "environment",
    "level",
    "kind",
    "timestamp"
  ],
  "properties": {
    "interface_version": { "const": "1" },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production", "test", "local"]
    },
    "level": { "type": "string", "enum": ["info", "warning", "error", "critical"] },
    "kind": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)+$",
      "description": "Stable event kind with at least two lowercase underscore-separated segments."
    },
    "message": { "type": "string", "maxLength": 1024 },
    "count": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 1 },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35,
      "pattern": "Z$"
    }
  }
}

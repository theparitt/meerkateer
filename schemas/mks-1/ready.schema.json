{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meerkateer.dev/schemas/mks-1/ready.schema.json",
  "title": "MKS-1 Readiness Response",
  "description": "Response body for GET /ready. ready is true only when every check passes; HTTP 503 when not ready. Minimal body (no build block).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ready",
    "service",
    "project",
    "environment",
    "interface",
    "interface_version",
    "checks",
    "timestamp"
  ],
  "properties": {
    "ready": { "type": "boolean" },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production", "test", "local"]
    },
    "interface": { "const": "meerkateer" },
    "interface_version": { "const": "1" },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok"],
        "properties": {
          "ok": { "type": "boolean" },
          "error": {
            "type": "string",
            "enum": ["unavailable", "timeout", "misconfigured", "disabled", "unknown"]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
            "then": { "required": ["error"] }
          },
          {
            "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
            "then": { "not": { "required": ["error"] } }
          }
        ]
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35,
      "pattern": "Z$"
    }
  }
}

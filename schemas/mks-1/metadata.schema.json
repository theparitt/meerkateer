{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meerkateer.dev/schemas/mks-1/metadata.schema.json",
  "title": "MKS-1 Service Metadata",
  "description": "Response body for GET /.well-known/meerkateer.json. Safe to expose publicly; MUST NOT contain secrets.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "interface",
    "interface_version",
    "service",
    "project",
    "environment",
    "runtime",
    "version",
    "build",
    "endpoints",
    "capabilities"
  ],
  "properties": {
    "interface": { "const": "meerkateer" },
    "interface_version": { "const": "1" },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production", "test", "local"]
    },
    "runtime": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["built_at_utc", "git_sha", "git_branch"],
      "properties": {
        "built_at_utc": {
          "anyOf": [
            { "const": "unknown" },
            { "type": "string", "format": "date-time", "maxLength": 35, "pattern": "Z$" }
          ]
        },
        "git_sha": { "type": "string", "minLength": 1, "maxLength": 128 },
        "git_branch": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health", "ready", "metrics"],
      "properties": {
        "health": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/\\S*$" },
        "ready": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/\\S*$" },
        "metrics": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/\\S*$" },
        "server_info": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/\\S*$" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health", "readiness", "prometheus_metrics"],
      "properties": {
        "health": { "type": "boolean" },
        "readiness": { "type": "boolean" },
        "prometheus_metrics": { "type": "boolean" },
        "server_info": { "type": "boolean" },
        "push_heartbeat": { "type": "boolean" },
        "push_event": { "type": "boolean" },
        "push_deploy": { "type": "boolean" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meerkateer.dev/schemas/mka-1/telemetry.schema.json",
  "title": "MKA-1 Telemetry Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "agent_id", "batch_id", "first_sequence", "last_sequence", "sent_at", "records"],
  "properties": {
    "protocol_version": { "const": "1" },
    "agent_id": { "type": "string", "format": "uuid" },
    "batch_id": { "type": "string", "format": "uuid" },
    "first_sequence": { "type": "integer", "minimum": 1 },
    "last_sequence": { "type": "integer", "minimum": 1 },
    "sent_at": { "$ref": "#/$defs/timestamp" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "oneOf": [{ "$ref": "#/$defs/sample" }, { "$ref": "#/$defs/event" }] }
    }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time", "maxLength": 35, "pattern": "Z$" },
    "attributes": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_.]{0,63}$" },
      "additionalProperties": { "type": "string", "maxLength": 128 }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sequence", "record_id", "observed_at", "metric", "value", "attributes"],
      "properties": {
        "type": { "const": "sample" },
        "sequence": { "type": "integer", "minimum": 1 },
        "record_id": { "type": "string", "format": "uuid" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "metric": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.]+$" },
        "value": { "type": "number" },
        "attributes": { "$ref": "#/$defs/attributes" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sequence", "record_id", "observed_at", "kind", "severity", "attributes"],
      "properties": {
        "type": { "const": "event" },
        "sequence": { "type": "integer", "minimum": 1 },
        "record_id": { "type": "string", "format": "uuid" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "kind": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(_[a-z0-9]+)+$" },
        "severity": { "type": "string", "enum": ["info", "warning", "error", "critical"] },
        "message": { "type": "string", "maxLength": 1024 },
        "attributes": { "$ref": "#/$defs/attributes" }
      }
    }
  }
}

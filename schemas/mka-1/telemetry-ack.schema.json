{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meerkateer.dev/schemas/mka-1/telemetry-ack.schema.json",
  "title": "MKA-1 Telemetry Acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "agent_id", "batch_id", "status", "accepted_through_sequence", "rejected", "server_time"],
  "properties": {
    "protocol_version": { "const": "1" },
    "agent_id": { "type": "string", "format": "uuid" },
    "batch_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["accepted", "partial", "rejected"] },
    "accepted_through_sequence": { "type": "integer", "minimum": 0 },
    "rejected": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "reason"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "enum": ["invalid_record", "oversized_record", "unsupported_metric", "unsafe_attributes", "stale_record"] }
        }
      }
    },
    "server_time": { "type": "string", "format": "date-time", "maxLength": 35, "pattern": "Z$" }
  }
}

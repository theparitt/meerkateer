# Copy with `make bootstrap`. That command generates local secrets and never commits them.
POSTGRES_DB=meerkateer
POSTGRES_USER=meerkateer_owner
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
MEERKATEER_APP_PASSWORD=replace-with-a-different-long-random-local-password
MEERKATEER_DATABASE_URL=postgres://meerkateer_app:replace-with-a-different-long-random-local-password@postgres:5432/meerkateer
MEERKATEER_WORKER_PASSWORD=replace-with-a-third-long-random-local-password
MEERKATEER_WORKER_DATABASE_URL=postgres://meerkateer_worker:replace-with-a-third-long-random-local-password@postgres:5432/meerkateer
MEERKATEER_DATABASE_MAX_CONNECTIONS=10
MEERKATEER_AUTH_RATE_LIMIT_PER_MINUTE=300
MEERKATEER_INGEST_RATE_LIMIT_PER_MINUTE=1200
MEERKATEER_HEARTBEAT_STALE_AFTER_SECONDS=180
MEERKATEER_BOOTSTRAP_TOKEN=replace-with-a-one-time-long-random-bootstrap-token
MEERKATEER_DEPLOYMENT_MODE=community
MEERKATEER_STORAGE_PROFILE=compact
MEERKATEER_BIND_ADDR=0.0.0.0:8080
MEERKATEER_API_PORT=6510
MEERKATEER_WEB_PORT=6511
MEERKATEER_SERVICE_ENVIRONMENT=development
MEERKATEER_METRICS_ENABLED=true
MEERKATEER_METRICS_TOKEN=replace-with-a-long-random-local-token
# Optional installation-level Community alert receiver (HTTPS; loopback HTTP for local tests).
MEERKATEER_ALERT_WEBHOOK_URL=
RUST_LOG=info

{
  "name": "@meerkateer/web",
  "version": "0.3.0-alpha.2",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "cloudflare:dev": "npm run build && wrangler dev --local",
    "cloudflare:set-api-origin": "wrangler secret put MEERKATEER_API_ORIGIN",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "generate:api": "openapi-typescript ../openapi/meerkateer.openapi.json -o src/generated/api.d.ts && biome format --write src/generated/api.d.ts",
    "check:api": "node scripts/check-generated-api.mjs",
    "test": "vitest run --config vite.config.ts"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.136.3"
  },
  "overrides": {
    "undici": "7.30.0"
  },
  "packageManager": "npm@10.9.8"
}
